{
  "manifest_version": 3,
  "name": "ChromaMath - Colorized Math for arXiv & PDFs",
  "version": "1.0.0",
  "description": "Deconstructs mathematical equations on arXiv and PDFs into intuitive, color-coordinated cognitive maps.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open ChromaMath",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://*.ar5iv.org/*",
    "https://*.wikipedia.org/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/*",
        "https://*.ar5iv.org/*",
        "https://*.wikipedia.org/*"
      ],
      "js": [
        "arxiv-detector.js",
        "snip-overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "snip_equation": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Snip equation from paper"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://arxiv.org/*",
        "https://*.ar5iv.org/*",
        "https://*.wikipedia.org/*"
      ]
    }
  ]
}
